# Core application
FLASK_ENV=development
APP_VERSION=3.1.0
PORT=5555

# Security
SECRET_KEY=replace-with-a-strong-32-plus-character-secret
JWT_SECRET_KEY=replace-with-a-separate-strong-32-plus-character-secret
AUTH_SERVICE_URL=https://auth.mardigrasworld.com

# Database
DATABASE_URL=sqlite:///instance/mardi_gras_dev.db
# Optional for managed PostgreSQL deployments when sslmode is not embedded in DATABASE_URL
DATABASE_SSL_MODE=

# CORS
# Development example:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5555,http://localhost:5556

# Startup behavior
AUTO_INIT_DB=true
AUTO_SEED_TOUR_EVAL=true
TRUST_PROXY_FIX=false

# Internal route protection
CUSTOMER_DATA_AUTH_REQUIRED=false
TOUR_EVAL_REPORTS_AUTH_REQUIRED=false
TOUR_EVAL_ADMIN_AUTH_REQUIRED=false

# Gunicorn
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# AWS S3 Configuration
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Email
EMAIL_PROVIDER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Mardi Gras World
FROM_EMAIL=
FROM_NAME=Mardi Gras World
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MGW_REPORT_DEFAULT_EMAILS=
MGW_COACHING_THRESHOLD=1.3
